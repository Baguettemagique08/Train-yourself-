# ── Supabase ──────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in from your Supabase project settings
# (Project Settings → API). Without these, the app runs in demo mode on mock
# data: reads fall back to local fixtures and writes throw a clear error.

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for the browser; RLS enforces access).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket for case documents (BDNs, lab reports, scans). Defaults to
# "documents" if unset. Create it as a PRIVATE bucket; files are served via
# short-lived signed URLs.
VITE_SUPABASE_DOCUMENTS_BUCKET=documents
